    "category": "Meals",
    "portions": 4,
    "ingredients": [
      "200g smoked firm tofu (crumbled)",
      "100g red lentils (dry)",
      "1 can chopped tomatoes (400g)",
      "1 onion (finely chopped)",
      "2 cloves garlic (minced)",
      "1 carrot (grated)",
      "1 tbsp olive oil",
